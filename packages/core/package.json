{
  "name": "@sls-testing/core",
  "version": "1.0.0",
  "description": "Typed, composable testing utilities for AWS Lambda — event builders, context mock, response asserters",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "jest --passWithNoTests",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist coverage"
  },
  "peerDependencies": {
    "@types/aws-lambda": ">=8.10.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "aws",
    "lambda",
    "serverless",
    "testing",
    "jest",
    "vitest",
    "mock",
    "event"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/brognilucas/sls-testing.git",
    "directory": "packages/core"
  }
}
